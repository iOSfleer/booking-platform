# Image tags
BACKEND_IMAGE=ghcr.io/your-org/booking-platform-backend
FRONTEND_IMAGE=ghcr.io/your-org/booking-platform-frontend
IMAGE_TAG=latest

# Database
POSTGRES_DB=booking_platform
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=change_me

# JWT
JWT_ISSUER=BookingPlatform
JWT_AUDIENCE=BookingPlatformClients
JWT_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY

# Email / SMTP
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=mailer-user
EMAIL_PASSWORD=mailer-pass
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_ENABLE_SSL=true

# Frontend runtime vars
NEXT_PUBLIC_API_URL=https://your-domain.example
NEXT_PUBLIC_COMPANY_ID=11111111-1111-1111-1111-111111111111
